# podman-mcp environment configuration
# Copy to .env and fill in values

# LLM sampling (for ctx.sample() agentic assistance)
PODMAN_MCP_SAMPLING_BASE_URL=http://localhost:11434/v1
PODMAN_MCP_SAMPLING_MODEL=llama3.2
PODMAN_MCP_SAMPLING_API_KEY=

# LLM provider auto-detection (set to 0 to disable glom-on entirely)
PODMAN_MCP_LLM_GLOM=1

# Manual LLM override (detected automatically if not set)
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_ENDPOINT=http://localhost:11434

# Podman CLI path override (auto-detected: native podman then WSL2)
PODMAN_CMD=podman

# MCP transport (stdio for Claude Desktop, http for webapp)
MCP_TRANSPORT=stdio

# HTTP auth for web bridge (chat page protection)
MCP_USER=sandra
MCP_PASS=sandra123

# Logging
LOG_LEVEL=WARNING
PODMAN_MCP_LOG_MAX_ENTRIES=1000
ENABLE_LOKI=0
ENABLE_LOGURU=0
LOKI_URL=http://localhost:3100

# MCP bridge (connect to external MCP servers)
MCP_BRIDGE_URLS=

# Grafana (monitoring integration, optional)
GRAFANA_PASSWORD=

# Environment tag
ENVIRONMENT=dev
